{
  "name": "ITBA_Cloud_Architecture_FP",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/aws-cli:1": {}
  },

  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y postgresql-client && python3 -m pip install -r requirements.txt && cp .env.example .env",
  "postStartCommand": "docker compose up -d",

  "forwardPorts": [4566, 5432],
  "portsAttributes": {
    "4566": { "label": "LocalStack (AWS)" },
    "5432": { "label": "PostgreSQL (RDS Mock)" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
